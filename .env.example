# ============================================================
# Пример конфигурации. Скопируйте в .env и вставьте свой ключ.
#   cp .env.example .env   (Windows: copy .env.example .env)
#
# ВАЖНО: .env исключён через .gitignore и НЕ должен попадать в git.
# ============================================================

# Base64-кодированный JWT-ключ из личного кабинета GigaChat
GIGACHAT_CREDENTIALS=your_base64_key_here

# (опционально) Модель GigaChat. Доступные варианты:
# GigaChat-2, GigaChat-2-Pro, GigaChat-2-Max,
# GigaChat-3-Lightning, GigaChat-3-Pro, GigaChat-3-Ultra
GIGACHAT_MODEL=GigaChat-3-Ultra